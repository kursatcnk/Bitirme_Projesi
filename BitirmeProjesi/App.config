<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- Kendi SQL Server adınızı yazın; varsayılan yereldeki ana örnek. SQL Express için: .\SQLEXPRESS -->
        <add name="GYM" connectionString="Data Source=.;Initial Catalog=GYM;Integrated Security=True" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <!-- Yeni üyeye hoş geldin mesajı. Boş bırakılan kanal kullanılmaz; şifreleri repoya göndermeyin. -->
        <add key="Sms.KullaniciAdi" value="" />
        <add key="Sms.Sifre" value="" />
        <add key="Sms.Gonderen" value="" />
        <add key="Eposta.KullaniciAdi" value="" />
        <add key="Eposta.Sifre" value="" />
        <add key="Eposta.Sunucu" value="smtp.gmail.com" />
        <add key="Eposta.Port" value="587" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
